#!/usr/bin/env bash
# tests/fleet-pins/fixtures/mock-bin/gh — mock `gh` for the fleet-pins live-read
# assertions. Lives under fixtures/ so gate_fast.sh's suite auto-discovery never
# runs it as a test (same contract as tests/phase-milestones/fixtures/mock-bin/gh).
#
# Driven by two env vars:
#   MOCK_GH_FIXTURE    directory holding one file per mocked repo:
#                        <owner>__<repo>.yml           → repo reachable, template
#                                                        present with this content
#                        <owner>__<repo>.absent        → repo reachable, no template
#                        (neither present)             → repo unreachable (404)
#   MOCK_GH_ARGS_FILE  optional; every invocation appends its argv here, so a
#                      test can prove `--source local` made zero gh calls.
#
# Only the two call shapes fleet_pins.py makes are handled; anything else exits
# 2 loudly rather than pretending to succeed, so a changed call site shows up as
# a test failure instead of a silent pass.

set -uo pipefail

if [[ -n "${MOCK_GH_ARGS_FILE:-}" ]]; then
    echo "$*" >> "${MOCK_GH_ARGS_FILE}"
fi

# `gh auth status` / `gh auth token --user X` — the second-account fallback
# (PR #102). MOCK_GH_SECOND names an account the active login cannot see; a
# fixture file <owner>__<repo>.second is readable ONLY when that account's
# token is presented via GH_TOKEN.
if [[ "${1:-}" == "auth" ]]; then
    case "${2:-}" in
        status)
            echo "github.com"
            echo "  ✓ Logged in to github.com account primary (~/.config/gh/hosts.yml)"
            echo "  - Active account: true"
            if [[ -n "${MOCK_GH_SECOND:-}" ]]; then
                echo "  ✓ Logged in to github.com account ${MOCK_GH_SECOND} (~/.config/gh/hosts.yml)"
                echo "  - Active account: false"
            fi
            exit 0 ;;
        token)
            # gh auth token --user <account>
            echo "mock-token-for-${4:-unknown}"
            exit 0 ;;
        *) echo "mock gh: unexpected auth subcommand: ${2:-<none>}" >&2; exit 2 ;;
    esac
fi

if [[ "${1:-}" != "api" ]]; then
    echo "mock gh: unexpected subcommand: ${1:-<none>}" >&2
    exit 2
fi

endpoint="${2:-}"
fixture_dir="${MOCK_GH_FIXTURE:-}"

# repos/<owner>/<repo>/pulls?... — open bump PRs (v1.31). A
# <owner>__<repo>.prs fixture holds one "number|title" per line, exactly what
# the real --jq produces; absent means the repo has no open PRs.
if [[ "${endpoint}" =~ ^repos/([^/]+)/([^/]+)/pulls ]]; then
    prs="${fixture_dir}/${BASH_REMATCH[1]}__${BASH_REMATCH[2]}.prs"
    [[ -f "${prs}" ]] && cat "${prs}"
    exit 0
fi

# repos/<owner>/<repo>[/contents/<path>]
if [[ "${endpoint}" =~ ^repos/([^/]+)/([^/]+)(/contents/.*)?$ ]]; then
    owner="${BASH_REMATCH[1]}"
    repo="${BASH_REMATCH[2]}"
    contents="${BASH_REMATCH[3]:-}"
else
    echo "mock gh: unexpected endpoint: ${endpoint}" >&2
    exit 2
fi

base="${fixture_dir}/${owner}__${repo}"

# A `.second` fixture is visible ONLY when the second account's token is
# presented — this is the Osigin-LLC/SQRL shape, where the active login gets a
# bare 404 and a different authenticated account can read the repo.
second_ok=0
if [[ -f "${base}.second" && -n "${MOCK_GH_SECOND:-}" \
      && "${GH_TOKEN:-}" == "mock-token-for-${MOCK_GH_SECOND}" ]]; then
    second_ok=1
fi

# The repo probe: reachable when a fixture form exists that this caller can see.
if [[ -z "${contents}" ]]; then
    if [[ -f "${base}.yml" || -f "${base}.absent" || ${second_ok} -eq 1 ]]; then
        echo "${owner}/${repo}"
        exit 0
    fi
    echo "mock gh: Not Found (HTTP 404)" >&2
    exit 1
fi

if [[ ${second_ok} -eq 1 ]]; then
    base64 -w 0 < "${base}.second"
    echo
    exit 0
fi

# The contents call: only the .yml form has a template to return.
if [[ -f "${base}.yml" ]]; then
    base64 -w 0 < "${base}.yml"
    echo
    exit 0
fi

echo "mock gh: Not Found (HTTP 404)" >&2
exit 1
